{
  "schema": "producers/2",
  "note": "按顺序匹配，第一条命中即用，所以具体规则在前、通用规则在后。glob 以 ~/ 开头相对家目录，以 **/ 开头匹配任意层级；规则默认连子路径一起匹配；可选 exact=true 只匹配这个路径本身（不含子路径），only=file 只匹配已存在的单个文件（不匹配目录，路径本身及其子目录都不算）。card 必须是知识卡名。schema producers/2 起支持以下可选字段（旧 producers/1 规则照常加载，缺省即无）：bundle_ids=字符串数组，节点 glob 没命中、但扫描器按路径反查到的应用 bundle id（不分大小写精确相等）在其中时也算命中，用于沙盒容器等路径不固定的情况，命中后原样带进 producer；safety=safe/moderate/risky，清理风险档，其他值被忽略；blocked_by_processes=进程名数组，这些进程在运行时不宜动该目录；default_select=布尔，看板是否默认勾选。这些字段都只是事实提示，不改变 verdict 与任何删除判断。另：扫描器还会给每个节点的 producer 写 app / app_match / app_installed / shared_component（按 ~/Library 下 bundle id 命名目录反查已装应用得出），不由本文件配置。",
  "rules": [
    {"glob": "~/.android/debug.keystore", "tool": "android", "card": "android", "hint": "Android 调试签名密钥，丢了会换签名", "safety": "risky", "default_select": false},
    {"glob": "**/*.keystore", "tool": "android", "card": "android", "hint": "签名密钥库，丢了无法再签同一应用", "safety": "risky", "default_select": false},
    {"glob": "**/*.jks", "tool": "android", "card": "android", "hint": "签名密钥库，丢了无法再签同一应用", "safety": "risky", "default_select": false},
    {"glob": "~/.codex/**", "tool": "codex", "card": "codex", "hint": "Codex 会话 rollout、生成图、缓存与状态库"},
    {"glob": "~/.codex/.tmp", "tool": "codex", "card": "codex", "hint": "Codex 临时文件：Codex 没在运行时可以清，运行中只报告", "safety": "safe", "blocked_by_processes": ["Codex", "codex"], "default_select": false},
    {"glob": "~/.claude/**", "tool": "claude", "card": "claude-code", "hint": "Claude Code 项目会话、记忆与调试数据"},
    {"glob": "~/.local/share/claude", "tool": "claude", "card": "claude-code", "hint": "Claude Code 已安装的各版本二进制"},
    {"glob": "/private/tmp/claude-*", "tool": "claude", "card": "claude-code", "hint": "Claude Code 会话临时目录：当前会话与 24 小时内有改动的一律保留，其余看对应会话是否结束", "safety": "moderate", "default_select": false},
    {"glob": "~/.grok", "tool": "grok", "card": "grok", "hint": "Grok Build 会话与存储"},
    {"glob": "~/.gemini", "tool": "gemini", "card": "gemini-antigravity", "hint": "Gemini CLI / Antigravity 数据"},
    {"glob": "~/.antigravity", "tool": "antigravity", "card": "gemini-antigravity", "hint": "Antigravity 数据"},
    {"glob": "~/Library/Application Support/Antigravity", "tool": "antigravity", "card": "gemini-antigravity", "hint": "Antigravity 桌面端数据"},
